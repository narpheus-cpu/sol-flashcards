<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="io.github.narpheus.solmate" android:versionCode="112" android:versionName="1.1.2">
 <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="35"/>
